{
  "name": "cehp-verification",
  "private": true,
  "description": "Verification tooling for Cactus Ed's Happy Place.",
  "scripts": {
    "verify": "./scripts/verify-cehp.sh",
    "verify:process": "node scripts/check_process_manifest.mjs",
    "verify:w10": "bash scripts/verify-w10-full.sh",
    "smoke": "node tests/cehp_boot_smoke.mjs",
    "smoke:rebuild": "node tests/cehp_rebuild_smoke.mjs",
    "smoke:rebuild:cases": "node tests/cehp_rebuild_case_runs.mjs",
    "test:rebuild": "node --test tests/rebuild_logic.test.mjs",
    "test:replay": "node scripts/run_replays.mjs",
    "test:process": "node --test tests/process_manifest.test.mjs",
    "scan": "./scripts/studio-scan.sh"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
